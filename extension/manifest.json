{
  "manifest_version": 3,
  "name": "Facebook Groups dashboard",
  "version": "1.1.0",
  "description": "Reads new posts in your Facebook groups and sends them to your facebookgroups.fullstackpartner.com dashboard.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://facebookgroups.fullstackpartner.com/*", "https://facebookstats.fullstackpartner.com/*", "https://www.facebook.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.facebook.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "Facebook Groups dashboard" }
}
